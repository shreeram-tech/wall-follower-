// ==================== SAME-SIDE PIN MAPPING ====================
// Assigned exclusively to the power/GND side of the ESP32 board
const int ENA = 13; // Left Motor PWM speed
const int IN1 = 12; // Left Motor Direction 1
const int IN2 = 14; // Left Motor Direction 2
const int IN3 = 27; // Right Motor Direction 1
const int IN4 = 26; // Right Motor Direction 2
const int ENB = 25; // Right Motor PWM speed

// ==================== TEST CONSTANTS ====================
const int TEST_SPEED = 180;
const int freq = 30000;
const int resolution = 8;

void setup() {
  Serial.begin(115200);
  Serial.println("Full Motion Motor Test Initialized...");

  // Set motor control pins as outputs
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // New ESP32 Core v3.x PWM Attachment Syntax
  ledcAttach(ENA, freq, resolution);
  ledcAttach(ENB, freq, resolution);
}

void loop() {
  // 1. Move Forward
  Serial.println("Motion: Moving Forward");
  setMotors(TEST_SPEED, TEST_SPEED);
  delay(2000);

  // Stop briefly between tests
  setMotors(0, 0);
  delay(500);

  // 2. Move Backward
  Serial.println("Motion: Moving Backward");
  setMotors(-TEST_SPEED, -TEST_SPEED);
  delay(2000);

  setMotors(0, 0);
  delay(500);

  // 3. Turn Left 
  Serial.println("Motion: Turning Left");
  setMotors(-TEST_SPEED, TEST_SPEED);
  delay(1500);

  setMotors(0, 0);
  delay(500);

  // 4. Turn Right 
  Serial.println("Motion: Turning Right");
  setMotors(TEST_SPEED, -TEST_SPEED);
  delay(1500);

  // Stop before restarting the loop
  Serial.println("Motion: Stopping for 2 seconds...");
  setMotors(0, 0);
  delay(2000);
}

// ==================== MOTOR CONTROL FUNCTION ====================
void setMotors(int leftSpeed, int rightSpeed) {
  // Left Motor Control
  if (leftSpeed > 0) {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    ledcWrite(ENA, leftSpeed);
  } else if (leftSpeed < 0) {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    ledcWrite(ENA, abs(leftSpeed));
  } else {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    ledcWrite(ENA, 0);
  }

  // Right Motor Control
  if (rightSpeed > 0) {
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
    ledcWrite(ENB, rightSpeed);
  } else if (rightSpeed < 0) {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    ledcWrite(ENB, abs(rightSpeed));
  } else {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
    ledcWrite(ENB, 0);
  }
}
